{
  "name": "angular-signal-forms-migration-mcp",
  "version": "0.5.2",
  "mcpName": "io.github.Alvi97/angular-signal-forms-migration-mcp",
  "description": "MCP server that detects Angular Reactive Forms constructs and advises on migrating them to Angular Signal Forms (recipes verified against v22). Detect-and-advise only — never edits your code.",
  "author": "Alvi97 (https://github.com/Alvi97)",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "angular-signal-forms-migration-mcp": "dist/server.js",
    "signal-forms-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-data.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:audit": "npm run build && node dist/cli/docs-audit.js",
    "docs:links": "npm run build && node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start": "node dist/server.js",
    "version": "node scripts/sync-server-json.mjs && git add server.json",
    "prepublishOnly": "npm run check && npm run build",
    "verify:install": "npm --prefix verify install",
    "verify:recipes": "npm run build && node verify/generate.mjs && npx tsc -p verify/tsconfig.json",
    "data:update-steps": "node scripts/fetch-update-steps.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "angular",
    "angular-forms",
    "signal-forms",
    "angular-signals",
    "reactive-forms",
    "reactive-forms-migration",
    "forms",
    "migration",
    "codemod",
    "angular-22",
    "angular-21"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvi97/angular-signal-forms-migration-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Alvi97/angular-signal-forms-migration-mcp/issues"
  },
  "homepage": "https://github.com/Alvi97/angular-signal-forms-migration-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
